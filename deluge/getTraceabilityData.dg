string for_traceability_report_fetch_data(string itemcode)
{
	response = Map();
	data = Map();
	code = "";
	if(itemcode != null)
	{
		code = itemcode.trim();
	}
	itemSoNos = Map();
	itemMrNos = Map();
	poIds = Map();
	try
	{
		imList = List();
		itemId = null;
		ims = Item_Master[Item_Code == code];
		for each imr in ims
		{
			m = Map();
			m.put("ID", imr.ID);
			m.put("Item_Code", imr.Item_Code);
			m.put("Item_Name", imr.Item_Name);
			m.put("Unit", imr.Unit);
			imList.add(m);
			if(itemId == null)
			{
				itemId = imr.ID;
			}
		}
		data.put("API_ITEM_MASTER", imList);
		soList = List();
		disList = List();
		sos = Sales_Order_Subform[ITEM_CODE == code];
		for each sor in sos
		{
			soNo = "";
			soDate = "";
			custName = "";
			smName = "";
			soLink = sor.Lookup;
			if(soLink == null)
			{
				soLink = sor.Sales_Order;
			}
			if(soLink != null)
			{
				so = Sales_Order[ID == soLink.ID];
				if(so != null)
				{
					soNo = so.Order_No;
					if(so.Date_field != null)
					{
						soDate = so.Date_field.toString("dd-MMM-yyyy");
					}
					if(so.Customer != null)
					{
						custName = so.Customer.Name;
					}
					if(so.Sales_Man != null)
					{
						smName = so.Sales_Man.Name;
					}
				}
			}
			if(soNo == "")
			{
				continue;
			}
			itemSoNos.put(soNo,"1");
			m = Map();
			m.put("ID", sor.ID);
			m.put("ITEM_CODE", sor.ITEM_CODE);
			m.put("QTY", sor.QTY);
			m.put("RATE", sor.RATE);
			m.put("UNIT", sor.UNIT);
			m.put("Dismissed_Qty", sor.Dismissed_Qty);
			nm = Map();
			nm.put("Item_Code", sor.ITEM_CODE);
			try
			{
				nm.put("zc_display_value", sor.ITEM_NAME.Item_Name);
			}
			catch (e1)
			{
				nm.put("zc_display_value", "");
			}
			m.put("ITEM_NAME", nm);
			m.put("Lookup.Order_No", soNo);
			m.put("Lookup.Date_field", soDate);
			cm = Map();
			cm.put("Name", custName);
			cm.put("zc_display_value", custName);
			m.put("Lookup.Customer", cm);
			m.put("Lookup.Sales_Man", smName);
			soList.add(m);
			if(sor.Dismissed_Qty != null && sor.Dismissed_Qty > 0)
			{
				dm = Map();
				dm.put("ID", sor.ID);
				dm.put("ITEM_CODE", sor.ITEM_CODE);
				dm.put("Dismissed_Qty", sor.Dismissed_Qty);
				dm.put("QTY", sor.QTY);
				lk = Map();
				lk.put("Order_No", soNo);
				lk.put("zc_display_value", soNo);
				dm.put("Lookup", lk);
				dcm = Map();
				dcm.put("Name", custName);
				dm.put("Lookup.Customer", dcm);
				dm.put("Lookup.Sales_Man", smName);
				disList.add(dm);
			}
		}
		data.put("SALES_ORDERS_ITEMWISE", soList);
		data.put("Dismissed_Sales_Order", disList);
		poList = List();
		pos = Purchase_Order_Subform[ITEMCODE == code];
		for each por in pos
		{
			poNo = "";
			poDate = "";
			poStatus = "";
			if(por.Purchase_Order != null)
			{
				poNo = por.Purchase_Order.Order_No;
				if(por.Purchase_Order.Date_field != null)
				{
					poDate = por.Purchase_Order.Date_field.toString("dd-MMM-yyyy");
				}
				poStatus = por.Purchase_Order.PO_Status;
				poKey = por.Purchase_Order.ID.toString();
				poIds.put(poKey,"1");
			}
			if(poStatus != "Void")
			{
				m = Map();
				m.put("ITEMCODE", por.ITEMCODE);
				m.put("QTY", por.QTY);
				m.put("Purchase_Order", poNo);
				m.put("Purchase_Order.Date_field", poDate);
				poList.add(m);
			}
		}
		data.put("PURCHASE_ORDERS_ITEMWISE", poList);
		allocList = List();
		allocQtyList = List();
		transitList = List();
		receiveList = List();
		billList = List();
		transitSeen = Map();
		receiveSeen = Map();
		if(itemId != null)
		{
			allocs = MATERIAL_REQUEST_ALLOCATION[Item_Master == itemId];
			for each a in allocs
			{
				am = Map();
				am.put("ID", a.ID);
				iim = Map();
				iim.put("ID", a.Item_Master.ID);
				am.put("Item_Master", iim);
				if(a.Purchase_Transist != null)
				{
					tm = Map();
					tm.put("ID", a.Purchase_Transist.ID);
					am.put("Purchase_Transist", tm);
				}
				if(a.Purchase_Receives != null)
				{
					rm = Map();
					rm.put("ID", a.Purchase_Receives.ID);
					try
					{
						rm.put("PO_receive_No", a.Purchase_Receives.PO_receive_No);
					}
					catch (e2)
					{
						rm.put("PO_receive_No", "");
					}
					am.put("Purchase_Receives", rm);
				}
				allocList.add(am);
				for each ali in a.LINE_ITEM
				{
					q = Map();
					aa = Map();
					aa.put("ID", a.ID);
					q.put("MATERIAL_REQUEST_ALLOCATION", aa);
					mm = Map();
					mrNo = "";
					try
					{
						if(ali.Material_Request != null)
						{
							mrNo = ali.Material_Request.Request_No;
						}
					}
					catch (e3)
					{
						mrNo = "";
					}
					mm.put("Request_No", mrNo);
					q.put("Material_Request", mm);
					q.put("QTY", ali.QTY);
					q.put("REQ_QTY", ali.REQ_QTY);
					if(ali.Sales_Order_Subform != null)
					{
						ss = Map();
						ss.put("ID", ali.Sales_Order_Subform.ID);
						q.put("Sales_Order_Subform", ss);
					}
					allocQtyList.add(q);
					if(mrNo != "")
					{
						itemMrNos.put(mrNo,"1");
					}
				}
				if(a.Purchase_Transist != null)
				{
					tid = a.Purchase_Transist.ID.toString();
					if(transitSeen.get(tid) == null)
					{
						transitSeen.put(tid,"1");
						tr = Map();
						tr.put("ID", a.Purchase_Transist.ID);
						tr.put("Order_No", a.Purchase_Transist.Order_No);
						if(a.Purchase_Transist.Delivery_Date != null)
						{
							tr.put("Delivery_Date", a.Purchase_Transist.Delivery_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							tr.put("Delivery_Date", "");
						}
						transitList.add(tr);
					}
				}
				if(a.Purchase_Receives != null)
				{
					rid = a.Purchase_Receives.ID.toString();
					if(receiveSeen.get(rid) == null)
					{
						receiveSeen.put(rid,"1");
						rr = Map();
						rr.put("ID", a.Purchase_Receives.ID);
						rr.put("PO_receive_No", a.Purchase_Receives.PO_receive_No);
						rr.put("POR_Status", a.Purchase_Receives.POR_Status);
						if(a.Purchase_Receives.Purchase_Receives_Date != null)
						{
							rr.put("Purchase_Receives_Date", a.Purchase_Receives.Purchase_Receives_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							rr.put("Purchase_Receives_Date", "");
						}
						receiveList.add(rr);
					}
				}
			}
		}
		if(receiveSeen.size() > 0)
		{
			allBills = Bill[ID != 0];
			for each b in allBills
			{
				bstat = "";
				if(b.STATUS != null)
				{
					bstat = b.STATUS;
				}
				if(bstat != "Void" && bstat != "Deleted")
				{
					if(b.Purchase_Receives_No != null)
					{
						matchedPrl = List();
						for each prRec in b.Purchase_Receives_No
						{
							prid = "";
							try
							{
								prid = prRec.ID.toString();
							}
							catch (e20)
							{
								prid = "";
							}
							if(prid != "" && receiveSeen.get(prid) != null)
							{
								pm = Map();
								pm.put("ID", prRec.ID);
								matchedPrl.add(pm);
							}
						}
						if(!matchedPrl.isEmpty())
						{
							bm = Map();
							bm.put("Bill_No", b.Bill_No);
							if(b.BilDate != null)
							{
								bm.put("BilDate", b.BilDate.toString("dd-MMM-yyyy"));
							}
							else
							{
								bm.put("BilDate", "");
							}
							bm.put("STATUS", bstat);
							bm.put("Purchase_Receives_No", matchedPrl);
							billList.add(bm);
						}
					}
				}
			}
		}
		data.put("All_Material_Request_Allocations", allocList);
		data.put("MATERIAL_REQUEST_ALLOCATION_SUBFORM_Report", allocQtyList);
		data.put("API_PURCHASE_TRANSIT", transitList);
		data.put("API_PURCHASE_RECEIVE", receiveList);
		data.put("API_of_BILLS", billList);
		poHdrList = List();
		poKeyList = poIds.keys();
		for each pk in poKeyList
		{
			pidL = pk.toLong();
			ph = Purchase_Order[ID == pidL];
			if(ph != null)
			{
				m = Map();
				m.put("Order_No", ph.Order_No);
				if(ph.Date_field != null)
				{
					m.put("Date_field", ph.Date_field.toString("dd-MMM-yyyy"));
				}
				else
				{
					m.put("Date_field", "");
				}
				m.put("PO_Status", ph.PO_Status);
				mrs = List();
				if(ph.Material_Request != null)
				{
					for each mrRec in ph.Material_Request
					{
						one = Map();
						try
						{
							one.put("Request_No", mrRec.Request_No);
						}
						catch (e4)
						{
							one.put("Request_No", "");
						}
						mrs.add(one);
					}
				}
				m.put("Material_Request", mrs);
				poHdrList.add(m);
			}
		}
		data.put("Purchase_Order_Report", poHdrList);
		mrList = List();
		mrecs = Material_Request[ID != 0];
		for each mrr in mrecs
		{
			soNos = Map();
			soSm = Map();
			itemNosSum = 0;
			lineSm = "";
			if(mrr.Line_Item != null)
			{
				for each mli in mrr.Line_Item
				{
					isItem = false;
					try
					{
						if(mli.Item != null && mli.Item.Item_Code == code)
						{
							isItem = true;
						}
					}
					catch (e10)
					{
						isItem = false;
					}
					if(isItem)
					{
						lineNos = 0;
						if(mli.Nos != null)
						{
							lineNos = mli.Nos;
						}
						itemNosSum = itemNosSum + lineNos;
						try
						{
							if(mli.SALES_MAN != null)
							{
								lineSm = mli.SALES_MAN.Name;
							}
						}
						catch (e11)
						{
							lineSm = lineSm;
						}
						if(mli.Sales_Order != null)
						{
							for each lso in mli.Sales_Order
							{
								lsoNo = "";
								try
								{
									lsoNo = lso.Order_No;
								}
								catch (e12)
								{
									lsoNo = "";
								}
								if(lsoNo != "")
								{
									prevNos = 0;
									if(soNos.get(lsoNo) != null)
									{
										prevNos = soNos.get(lsoNo);
									}
									soNos.put(lsoNo, prevNos + lineNos);
									soSm.put(lsoNo, lineSm);
								}
							}
						}
					}
				}
			}
			refs = List();
			keep = false;
			if(mrr.Sales_Order_no != null)
			{
				for each soRec in mrr.Sales_Order_no
				{
					ono = "";
					try
					{
						ono = soRec.Order_No;
					}
					catch (e5)
					{
						ono = "";
					}
					one = Map();
					one.put("Order_No", ono);
					if(soNos.get(ono) != null)
					{
						one.put("Nos", soNos.get(ono));
					}
					if(soSm.get(ono) != null)
					{
						one.put("Salesman", soSm.get(ono));
					}
					refs.add(one);
					if(ono != "" && itemSoNos.get(ono) != null)
					{
						keep = true;
					}
				}
			}
			if(keep == false && itemMrNos.get(mrr.Request_No) != null)
			{
				keep = true;
			}
			if(keep)
			{
				m = Map();
				m.put("Request_No", mrr.Request_No);
				if(mrr.Date_field != null)
				{
					m.put("Date_field", mrr.Date_field.toString("dd-MMM-yyyy"));
				}
				else
				{
					m.put("Date_field", "");
				}
				dB = "";
				sB = "";
				try
				{
					if(mrr.Destination_Branch != null)
					{
						dB = mrr.Destination_Branch.Branch;
					}
				}
				catch (e6)
				{
					dB = "";
				}
				try
				{
					if(mrr.Source_Branch != null)
					{
						sB = mrr.Source_Branch.Branch;
					}
				}
				catch (e7)
				{
					sB = "";
				}
				m.put("Destination_Branch", dB);
				m.put("Source_Branch", sB);
				m.put("Item_Nos", itemNosSum);
				m.put("Salesman", lineSm);
				m.put("Sales_Order_no", refs);
				mrList.add(m);
			}
		}
		data.put("Material_Request_Report", mrList);
		invMap = Map();
		invLines = Sales_Invoice_Line_Items[ITEM_CODE == code];
		for each invli in invLines
		{
			if(invli.Sales_Invoice != null)
			{
				invId = invli.Sales_Invoice.ID.toString();
				em = invMap.get(invId);
				if(em == null)
				{
					em = Map();
					inv = Sales_Invoice[ID == invli.Sales_Invoice.ID];
					if(inv != null)
					{
						em.put("Sales_Invoice_No", inv.Invoice_No);
						if(inv.Invoice_Date != null)
						{
							em.put("Sales_Invoice_Date", inv.Invoice_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							em.put("Sales_Invoice_Date", "");
						}
						sono = "";
						try
						{
							if(inv.Sales_Order_NO != null)
							{
								sono = inv.Sales_Order_NO.Order_No;
							}
						}
						catch (e8)
						{
							sono = "";
						}
						em.put("Sales_Order_no", sono);
						icn = "";
						try
						{
							if(inv.Customer != null)
							{
								icn = inv.Customer.Name;
							}
						}
						catch (e9)
						{
							icn = "";
						}
						em.put("Customer", icn);
					}
					em.put("Status", "");
					em.put("Line_Item", List());
					invMap.put(invId, em);
				}
				lim = Map();
				lim.put("ITEM_CODE", invli.ITEM_CODE);
				lim.put("QTY", invli.QTY);
				liList = em.get("Line_Item");
				liList.add(lim);
			}
		}
		invList = List();
		invKeys = invMap.keys();
		for each k in invKeys
		{
			invList.add(invMap.get(k));
		}
		data.put("API_SALES_INVOICES", invList);
		cnMap = Map();
		cnLines = Credit_Note_Line_Items[ITEM_CODE == code];
		for each cnli in cnLines
		{
			if(cnli.Credit_Note != null)
			{
				cnId = cnli.Credit_Note.ID.toString();
				em = cnMap.get(cnId);
				if(em == null)
				{
					em = Map();
					cnRec = Credit_Note[ID == cnli.Credit_Note.ID];
					if(cnRec != null)
					{
						em.put("Credit_No", cnRec.Credit_No);
						if(cnRec.Credit_Note_Date != null)
						{
							em.put("Credit_Note_Date", cnRec.Credit_Note_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							em.put("Credit_Note_Date", "");
						}
						em.put("Credit_Note_Status", cnRec.Credit_Note_Status);
					}
					em.put("Line_Item", List());
					cnMap.put(cnId, em);
				}
				lim = Map();
				lim.put("ITEM_CODE", cnli.ITEM_CODE);
				lim.put("QTY", cnli.QTY);
				liList = em.get("Line_Item");
				liList.add(lim);
			}
		}
		cnList = List();
		cnKeys = cnMap.keys();
		for each k in cnKeys
		{
			cnList.add(cnMap.get(k));
		}
		data.put("API_CREDIT_NOTES", cnList);
		response.put("code", 3000);
		response.put("data", data);
	}
	catch (ex)
	{
		response.put("code", 0);
		response.put("data", data);
		response.put("error", ex.toString());
	}
	return response.toString();
}
