/* ============================================================================
   CUSTOM API : getTraceabilityData        (NATIVE FETCH version — no connection)
   ----------------------------------------------------------------------------
   Reads app data with native Deluge fetch and returns it in the SAME JSON shape
   the widget parses. Runs as the app OWNER, so a viewer's own report/form
   permissions never block a fetch (no code 2898 / 403). No OAuth connection.

   Fetch idiom used (as in your Button_action example):
     - rec = Form[ID == x];       -> SINGLE record; null-check, then rec.Field
     - recs = Form[criteria];     -> COLLECTION; iterate with "for each"
     - a lookup field IS a record: rec.Lookup.ID, rec.Lookup.Order_No, etc.

   DEPLOY (admin, one time)
   ------------------------
   Microservices -> Custom API -> Create:
     Name/link name : getTraceabilityData   (must match CUSTOM_API in index.html)
     Method         : POST      Response type : JSON     User scope : All users
     Parameters (exact names & order):
       report (String, mandatory), criteria (String), from_index (Number), limit (Number)
   Paste the BODY below; keep the generated argument names report / criteria /
   from_index / limit.

   VERIFY IN CREATOR (native fetch can't see these from outside)
     1) Lookup display names use the referenced form's name field:
        Customer.Name, Employee.Name (salesman), Branch.Name — adjust ".Name" if a
        form uses a different name field (Customer & Employee DO have "Name").
     2) Void Sales Invoices are NOT filtered (the Sales_Invoice form has no status
        field). PO / Receive / Bill / Credit Note void ARE filtered via status.
     3) Dates returned as "dd-MMM-yyyy".
   ============================================================================ */

/* ----------------------- function body starts here ----------------------- */

response = Map();
data = List();

/* native fetch returns the whole set at once -> only page 1 carries data */
startIndex = 1;
if(from_index != null && from_index.toString().trim() != "")
{
	startIndex = from_index.toString().toLong();
}
if(startIndex > 1)
{
	response.put("code", 3000);
	response.put("data", data);
	return response;
}

rep = "";
if(report != null)
{
	rep = report.trim();
}
crit = "";
if(criteria != null)
{
	crit = criteria.toString().trim();
}

/* item code pulled out of a criteria like (Line_Item.ITEM_CODE == "99") */
itemCode = "";
if(crit.contains("\""))
{
	itemCode = crit.subString(crit.indexOf("\"") + 1, crit.lastIndexOf("\""));
}

allCrit = "ID != 0";
useCrit = if(crit == "", allCrit, crit);

try
{
	/* ---------- ITEM MASTER : API_ITEM_MASTER -> Item_Master ---------- */
	if(rep == "API_ITEM_MASTER")
	{
		recs = Item_Master[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("ID", r.ID);
			m.put("Item_Code", r.Item_Code);
			m.put("Item_Name", r.Item_Name);
			m.put("Unit", r.Unit);
			data.add(m);
		}
	}
	/* ---------- SALES ORDERS ITEMWISE : SALES_ORDERS_ITEMWISE -> Sales_Order_Subform ---------- */
	else if(rep == "SALES_ORDERS_ITEMWISE")
	{
		recs = Sales_Order_Subform[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("ID", r.ID);
			m.put("ITEM_CODE", r.ITEM_CODE);
			m.put("QTY", r.QTY);
			m.put("RATE", r.RATE);
			m.put("UNIT", r.UNIT);
			m.put("Dismissed_Qty", r.Dismissed_Qty);
			nm = Map();
			nm.put("Item_Code", r.ITEM_CODE);
			try { nm.put("zc_display_value", r.ITEM_NAME.Item_Name); } catch (e1) { nm.put("zc_display_value", ""); }
			m.put("ITEM_NAME", nm);
			soNo = "";
			soDate = "";
			custName = "";
			smName = "";
			if(r.Lookup != null)
			{
				so = Sales_Order[ID == r.Lookup.ID];
				if(so != null)
				{
					soNo = so.Order_No;
					if(so.Date_field != null) { soDate = so.Date_field.toString("dd-MMM-yyyy"); }
					if(so.Customer != null) { custName = so.Customer.Name; }
					if(so.Sales_Man != null) { smName = so.Sales_Man.Name; }
				}
			}
			m.put("Lookup.Order_No", soNo);
			m.put("Lookup.Date_field", soDate);
			cm = Map();
			cm.put("Name", custName);
			cm.put("zc_display_value", custName);
			m.put("Lookup.Customer", cm);
			m.put("Lookup.Sales_Man", smName);
			data.add(m);
		}
	}
	/* ---------- DISMISSED SALES ORDER : Dismissed_Sales_Order -> Sales_Order_Subform (Dismissed_Qty>0) ---------- */
	else if(rep == "Dismissed_Sales_Order")
	{
		recs = Sales_Order_Subform[useCrit];
		for each r in recs
		{
			dq = r.Dismissed_Qty;
			if(dq != null && dq > 0)
			{
				m = Map();
				m.put("ID", r.ID);
				m.put("ITEM_CODE", r.ITEM_CODE);
				m.put("Dismissed_Qty", dq);
				m.put("QTY", r.QTY);
				soNo = "";
				custName = "";
				smName = "";
				if(r.Lookup != null)
				{
					so = Sales_Order[ID == r.Lookup.ID];
					if(so != null)
					{
						soNo = so.Order_No;
						if(so.Customer != null) { custName = so.Customer.Name; }
						if(so.Sales_Man != null) { smName = so.Sales_Man.Name; }
					}
				}
				lk = Map();
				lk.put("Order_No", soNo);
				lk.put("zc_display_value", soNo);
				m.put("Lookup", lk);
				cm = Map();
				cm.put("Name", custName);
				m.put("Lookup.Customer", cm);
				m.put("Lookup.Sales_Man", smName);
				data.add(m);
			}
		}
	}
	/* ---------- PURCHASE ORDERS ITEMWISE : PURCHASE_ORDERS_ITEMWISE -> Purchase_Order_Subform ---------- */
	else if(rep == "PURCHASE_ORDERS_ITEMWISE")
	{
		recs = Purchase_Order_Subform[useCrit];
		for each r in recs
		{
			poNo = "";
			poDate = "";
			poStatus = "";
			if(r.Purchase_Order != null)
			{
				poNo = r.Purchase_Order.Order_No;
				if(r.Purchase_Order.Date_field != null) { poDate = r.Purchase_Order.Date_field.toString("dd-MMM-yyyy"); }
				poStatus = r.Purchase_Order.PO_Status;
			}
			if(poStatus != "Void")
			{
				m = Map();
				m.put("ITEMCODE", r.ITEMCODE);
				m.put("QTY", r.QTY);
				m.put("Purchase_Order", poNo);
				m.put("Purchase_Order.Date_field", poDate);
				data.add(m);
			}
		}
	}
	/* ---------- PURCHASE ORDER HEADER : Purchase_Order_Report -> Purchase_Order ---------- */
	else if(rep == "Purchase_Order_Report")
	{
		recs = Purchase_Order[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("Order_No", r.Order_No);
			if(r.Date_field != null) { m.put("Date_field", r.Date_field.toString("dd-MMM-yyyy")); } else { m.put("Date_field", ""); }
			m.put("PO_Status", r.PO_Status);
			mrs = List();
			if(r.Material_Request != null)
			{
				for each mrRec in r.Material_Request
				{
					one = Map();
					try { one.put("Request_No", mrRec.Request_No); } catch (e1) { }
					mrs.add(one);
				}
			}
			m.put("Material_Request", mrs);
			data.add(m);
		}
	}
	/* ---------- MATERIAL REQUEST : Material_Request_Report -> Material_Request ---------- */
	else if(rep == "Material_Request_Report")
	{
		recs = Material_Request[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("Request_No", r.Request_No);
			if(r.Date_field != null) { m.put("Date_field", r.Date_field.toString("dd-MMM-yyyy")); } else { m.put("Date_field", ""); }
			dBranch = "";
			sBranch = "";
			try { if(r.Destination_Branch != null) { dBranch = r.Destination_Branch.Name; } } catch (e1) { }
			try { if(r.Source_Branch != null) { sBranch = r.Source_Branch.Name; } } catch (e2) { }
			m.put("Destination_Branch", dBranch);
			m.put("Source_Branch", sBranch);
			sorefs = List();
			if(r.Sales_Order_no != null)
			{
				for each soRec in r.Sales_Order_no
				{
					one = Map();
					try { one.put("Order_No", soRec.Order_No); } catch (e3) { }
					sorefs.add(one);
				}
			}
			m.put("Sales_Order_no", sorefs);
			data.add(m);
		}
	}
	/* ---------- ALLOCATIONS : All_Material_Request_Allocations -> MATERIAL_REQUEST_ALLOCATION ---------- */
	else if(rep == "All_Material_Request_Allocations")
	{
		recs = MATERIAL_REQUEST_ALLOCATION[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("ID", r.ID);
			if(r.Item_Master != null)
			{
				im = Map();
				im.put("ID", r.Item_Master.ID);
				m.put("Item_Master", im);
			}
			if(r.Purchase_Transist != null)
			{
				tm = Map();
				tm.put("ID", r.Purchase_Transist.ID);
				m.put("Purchase_Transist", tm);
			}
			if(r.Purchase_Receives != null)
			{
				rm = Map();
				rm.put("ID", r.Purchase_Receives.ID);
				try { rm.put("PO_receive_No", r.Purchase_Receives.PO_receive_No); } catch (e1) { }
				m.put("Purchase_Receives", rm);
			}
			data.add(m);
		}
	}
	/* ---------- ALLOCATION QTY : MATERIAL_REQUEST_ALLOCATION_SUBFORM_Report -> MATERIAL_REQUEST_ALLOCATION_SUBFORM ---------- */
	else if(rep == "MATERIAL_REQUEST_ALLOCATION_SUBFORM_Report")
	{
		recs = MATERIAL_REQUEST_ALLOCATION_SUBFORM[useCrit];
		for each r in recs
		{
			m = Map();
			if(r.MATERIAL_REQUEST_ALLOCATION != null)
			{
				am = Map();
				am.put("ID", r.MATERIAL_REQUEST_ALLOCATION.ID);
				m.put("MATERIAL_REQUEST_ALLOCATION", am);
			}
			mrMap = Map();
			try { if(r.Material_Request != null) { mrMap.put("Request_No", r.Material_Request.Request_No); } } catch (e1) { }
			m.put("Material_Request", mrMap);
			m.put("QTY", r.QTY);
			m.put("REQ_QTY", r.REQ_QTY);
			if(r.Sales_Order_Subform != null)
			{
				sm = Map();
				sm.put("ID", r.Sales_Order_Subform.ID);
				m.put("Sales_Order_Subform", sm);
			}
			data.add(m);
		}
	}
	/* ---------- PURCHASE TRANSIT : API_PURCHASE_TRANSIT -> Purchase_Transist ---------- */
	else if(rep == "API_PURCHASE_TRANSIT")
	{
		recs = Purchase_Transist[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("ID", r.ID);
			m.put("Order_No", r.Order_No);
			if(r.Delivery_Date != null) { m.put("Delivery_Date", r.Delivery_Date.toString("dd-MMM-yyyy")); } else { m.put("Delivery_Date", ""); }
			data.add(m);
		}
	}
	/* ---------- PURCHASE RECEIVE : API_PURCHASE_RECEIVE -> Purchase_Receives ---------- */
	else if(rep == "API_PURCHASE_RECEIVE")
	{
		recs = Purchase_Receives[useCrit];
		for each r in recs
		{
			m = Map();
			m.put("ID", r.ID);
			m.put("PO_receive_No", r.PO_receive_No);
			m.put("POR_Status", r.POR_Status);
			if(r.Purchase_Receives_Date != null) { m.put("Purchase_Receives_Date", r.Purchase_Receives_Date.toString("dd-MMM-yyyy")); } else { m.put("Purchase_Receives_Date", ""); }
			data.add(m);
		}
	}
	/* ---------- BILLS : API_of_BILLS -> Bill ---------- */
	else if(rep == "API_of_BILLS")
	{
		recs = Bill[useCrit];
		for each r in recs
		{
			bstat = "";
			if(r.STATUS != null) { bstat = r.STATUS; }
			if(bstat != "Void" && bstat != "Deleted")
			{
				m = Map();
				m.put("Bill_No", r.Bill_No);
				if(r.BilDate != null) { m.put("BilDate", r.BilDate.toString("dd-MMM-yyyy")); } else { m.put("BilDate", ""); }
				m.put("STATUS", bstat);
				prl = List();
				if(r.Purchase_Receives_No != null)
				{
					for each prRec in r.Purchase_Receives_No
					{
						one = Map();
						try { one.put("ID", prRec.ID); } catch (e1) { }
						prl.add(one);
					}
				}
				m.put("Purchase_Receives_No", prl);
				data.add(m);
			}
		}
	}
	/* ---------- SALES INVOICES : API_SALES_INVOICES -> Sales_Invoice ---------- */
	else if(rep == "API_SALES_INVOICES")
	{
		recs = Sales_Invoice[allCrit];
		for each r in recs
		{
			items = List();
			for each li in r.Line_Item
			{
				if(itemCode == "" || li.ITEM_CODE == itemCode)
				{
					one = Map();
					one.put("ITEM_CODE", li.ITEM_CODE);
					one.put("QTY", li.QTY);
					items.add(one);
				}
			}
			if(!items.isEmpty())
			{
				m = Map();
				m.put("Sales_Invoice_No", r.Invoice_No);
				if(r.Invoice_Date != null) { m.put("Sales_Invoice_Date", r.Invoice_Date.toString("dd-MMM-yyyy")); } else { m.put("Sales_Invoice_Date", ""); }
				soNo = "";
				try { if(r.Sales_Order_NO != null) { soNo = r.Sales_Order_NO.Order_No; } } catch (e1) { }
				m.put("Sales_Order_no", soNo);
				custName = "";
				try { if(r.Customer != null) { custName = r.Customer.Name; } } catch (e2) { }
				m.put("Customer", custName);
				m.put("Status", "");
				m.put("Line_Item", items);
				data.add(m);
			}
		}
	}
	/* ---------- CREDIT NOTES : API_CREDIT_NOTES -> Credit_Note ---------- */
	else if(rep == "API_CREDIT_NOTES")
	{
		recs = Credit_Note[allCrit];
		for each r in recs
		{
			items = List();
			for each li in r.Line_Item
			{
				if(itemCode == "" || li.ITEM_CODE == itemCode)
				{
					one = Map();
					one.put("ITEM_CODE", li.ITEM_CODE);
					one.put("QTY", li.QTY);
					items.add(one);
				}
			}
			if(!items.isEmpty())
			{
				m = Map();
				m.put("Credit_No", r.Credit_No);
				if(r.Credit_Note_Date != null) { m.put("Credit_Note_Date", r.Credit_Note_Date.toString("dd-MMM-yyyy")); } else { m.put("Credit_Note_Date", ""); }
				m.put("Credit_Note_Status", r.Credit_Note_Status);
				m.put("Line_Item", items);
				data.add(m);
			}
		}
	}
	else
	{
		response.put("error", "Unknown report: " + rep);
	}
	response.put("code", 3000);
	response.put("data", data);
}
catch (ex)
{
	response.put("code", 0);
	response.put("data", data);
	response.put("error", ex.toString());
}

return response;
