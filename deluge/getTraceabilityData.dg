string for_traceability_report_fetch_data(string itemcode)
{
	response = Map();
	data = Map();
	code = "";
	if(itemcode != null)
	{
		code = itemcode.trim();
	}
	itemSoNos = Map();
	itemMrNos = Map();
	poIds = Map();
	try
	{
		imList = List();
		itemId = null;
		ims = Item_Master[Item_Code == code];
		for each r in ims
		{
			m = Map();
			m.put("ID", r.ID);
			m.put("Item_Code", r.Item_Code);
			m.put("Item_Name", r.Item_Name);
			m.put("Unit", r.Unit);
			imList.add(m);
			if(itemId == null)
			{
				itemId = r.ID;
			}
		}
		data.put("API_ITEM_MASTER", imList);
		soList = List();
		disList = List();
		sos = Sales_Order_Subform[ITEM_CODE == code];
		for each r in sos
		{
			soNo = "";
			soDate = "";
			custName = "";
			smName = "";
			if(r.Lookup != null)
			{
				so = Sales_Order[ID == r.Lookup.ID];
				if(so != null)
				{
					soNo = so.Order_No;
					if(so.Date_field != null)
					{
						soDate = so.Date_field.toString("dd-MMM-yyyy");
					}
					if(so.Customer != null)
					{
						custName = so.Customer.Name;
					}
					if(so.Sales_Man != null)
					{
						smName = so.Sales_Man.Name;
					}
				}
			}
			if(soNo != "")
			{
				itemSoNos.put(soNo,"1");
			}
			m = Map();
			m.put("ID", r.ID);
			m.put("ITEM_CODE", r.ITEM_CODE);
			m.put("QTY", r.QTY);
			m.put("RATE", r.RATE);
			m.put("UNIT", r.UNIT);
			m.put("Dismissed_Qty", r.Dismissed_Qty);
			nm = Map();
			nm.put("Item_Code", r.ITEM_CODE);
			try
			{
				nm.put("zc_display_value", r.ITEM_NAME.Item_Name);
			}
			catch (e1)
			{
				nm.put("zc_display_value", "");
			}
			m.put("ITEM_NAME", nm);
			m.put("Lookup.Order_No", soNo);
			m.put("Lookup.Date_field", soDate);
			cm = Map();
			cm.put("Name", custName);
			cm.put("zc_display_value", custName);
			m.put("Lookup.Customer", cm);
			m.put("Lookup.Sales_Man", smName);
			soList.add(m);
			if(r.Dismissed_Qty != null && r.Dismissed_Qty > 0)
			{
				dm = Map();
				dm.put("ID", r.ID);
				dm.put("ITEM_CODE", r.ITEM_CODE);
				dm.put("Dismissed_Qty", r.Dismissed_Qty);
				dm.put("QTY", r.QTY);
				lk = Map();
				lk.put("Order_No", soNo);
				lk.put("zc_display_value", soNo);
				dm.put("Lookup", lk);
				dcm = Map();
				dcm.put("Name", custName);
				dm.put("Lookup.Customer", dcm);
				dm.put("Lookup.Sales_Man", smName);
				disList.add(dm);
			}
		}
		data.put("SALES_ORDERS_ITEMWISE", soList);
		data.put("Dismissed_Sales_Order", disList);
		poList = List();
		pos = Purchase_Order_Subform[ITEMCODE == code];
		for each r in pos
		{
			poNo = "";
			poDate = "";
			poStatus = "";
			if(r.Purchase_Order != null)
			{
				poNo = r.Purchase_Order.Order_No;
				if(r.Purchase_Order.Date_field != null)
				{
					poDate = r.Purchase_Order.Date_field.toString("dd-MMM-yyyy");
				}
				poStatus = r.Purchase_Order.PO_Status;
				poKey = r.Purchase_Order.ID.toString();
				poIds.put(poKey,"1");
			}
			if(poStatus != "Void")
			{
				m = Map();
				m.put("ITEMCODE", r.ITEMCODE);
				m.put("QTY", r.QTY);
				m.put("Purchase_Order", poNo);
				m.put("Purchase_Order.Date_field", poDate);
				poList.add(m);
			}
		}
		data.put("PURCHASE_ORDERS_ITEMWISE", poList);
		allocList = List();
		allocQtyList = List();
		transitList = List();
		receiveList = List();
		billList = List();
		transitSeen = Map();
		receiveSeen = Map();
		if(itemId != null)
		{
			allocs = MATERIAL_REQUEST_ALLOCATION[Item_Master == itemId];
			for each a in allocs
			{
				am = Map();
				am.put("ID", a.ID);
				iim = Map();
				iim.put("ID", a.Item_Master.ID);
				am.put("Item_Master", iim);
				if(a.Purchase_Transist != null)
				{
					tm = Map();
					tm.put("ID", a.Purchase_Transist.ID);
					am.put("Purchase_Transist", tm);
				}
				if(a.Purchase_Receives != null)
				{
					rm = Map();
					rm.put("ID", a.Purchase_Receives.ID);
					try
					{
						rm.put("PO_receive_No", a.Purchase_Receives.PO_receive_No);
					}
					catch (e2)
					{
						rm.put("PO_receive_No", "");
					}
					am.put("Purchase_Receives", rm);
				}
				allocList.add(am);
				for each li in a.LINE_ITEM
				{
					q = Map();
					aa = Map();
					aa.put("ID", a.ID);
					q.put("MATERIAL_REQUEST_ALLOCATION", aa);
					mm = Map();
					mrNo = "";
					try
					{
						if(li.Material_Request != null)
						{
							mrNo = li.Material_Request.Request_No;
						}
					}
					catch (e3)
					{
						mrNo = "";
					}
					mm.put("Request_No", mrNo);
					q.put("Material_Request", mm);
					q.put("QTY", li.QTY);
					q.put("REQ_QTY", li.REQ_QTY);
					if(li.Sales_Order_Subform != null)
					{
						ss = Map();
						ss.put("ID", li.Sales_Order_Subform.ID);
						q.put("Sales_Order_Subform", ss);
					}
					allocQtyList.add(q);
					if(mrNo != "")
					{
						itemMrNos.put(mrNo,"1");
					}
				}
				if(a.Purchase_Transist != null)
				{
					tid = a.Purchase_Transist.ID.toString();
					if(transitSeen.get(tid) == null)
					{
						transitSeen.put(tid,"1");
						t = a.Purchase_Transist;
						tr = Map();
						tr.put("ID", a.Purchase_Transist.ID);
						tr.put("Order_No", t.Order_No);
						if(t.Delivery_Date != null)
						{
							tr.put("Delivery_Date", t.Delivery_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							tr.put("Delivery_Date", "");
						}
						transitList.add(tr);
					}
				}
				if(a.Purchase_Receives != null)
				{
					rid = a.Purchase_Receives.ID.toString();
					if(receiveSeen.get(rid) == null)
					{
						receiveSeen.put(rid,"1");
						rc = a.Purchase_Receives;
						rr = Map();
						rr.put("ID", a.Purchase_Receives.ID);
						rr.put("PO_receive_No", rc.PO_receive_No);
						rr.put("POR_Status", rc.POR_Status);
						if(rc.Purchase_Receives_Date != null)
						{
							rr.put("Purchase_Receives_Date", rc.Purchase_Receives_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							rr.put("Purchase_Receives_Date", "");
						}
						receiveList.add(rr);
					}
				}
				if(a.Bill != null && a.Purchase_Receives != null)
				{
					b = a.Bill;
					bstat = "";
					if(b.STATUS != null)
					{
						bstat = b.STATUS;
					}
					if(bstat != "Void" && bstat != "Deleted")
					{
						bm = Map();
						bm.put("Bill_No", b.Bill_No);
						if(b.BilDate != null)
						{
							bm.put("BilDate", b.BilDate.toString("dd-MMM-yyyy"));
						}
						else
						{
							bm.put("BilDate", "");
						}
						bm.put("STATUS", bstat);
						prl = List();
						one = Map();
						one.put("ID", a.Purchase_Receives.ID);
						prl.add(one);
						bm.put("Purchase_Receives_No", prl);
						billList.add(bm);
					}
				}
			}
		}
		data.put("All_Material_Request_Allocations", allocList);
		data.put("MATERIAL_REQUEST_ALLOCATION_SUBFORM_Report", allocQtyList);
		data.put("API_PURCHASE_TRANSIT", transitList);
		data.put("API_PURCHASE_RECEIVE", receiveList);
		data.put("API_of_BILLS", billList);
		poHdrList = List();
		poKeyList = poIds.keys();
		for each pk in poKeyList
		{
			pidL = pk.toLong();
			ph = Purchase_Order[ID == pidL];
			if(ph != null)
			{
				m = Map();
				m.put("Order_No", ph.Order_No);
				if(ph.Date_field != null)
				{
					m.put("Date_field", ph.Date_field.toString("dd-MMM-yyyy"));
				}
				else
				{
					m.put("Date_field", "");
				}
				m.put("PO_Status", ph.PO_Status);
				mrs = List();
				if(ph.Material_Request != null)
				{
					for each mrRec in ph.Material_Request
					{
						one = Map();
						try
						{
							one.put("Request_No", mrRec.Request_No);
						}
						catch (e4)
						{
							one.put("Request_No", "");
						}
						mrs.add(one);
					}
				}
				m.put("Material_Request", mrs);
				poHdrList.add(m);
			}
		}
		data.put("Purchase_Order_Report", poHdrList);
		mrList = List();
		mrecs = Material_Request[ID != 0];
		for each r in mrecs
		{
			refs = List();
			keep = false;
			if(r.Sales_Order_no != null)
			{
				for each soRec in r.Sales_Order_no
				{
					ono = "";
					try
					{
						ono = soRec.Order_No;
					}
					catch (e5)
					{
						ono = "";
					}
					one = Map();
					one.put("Order_No", ono);
					refs.add(one);
					if(ono != "" && itemSoNos.get(ono) != null)
					{
						keep = true;
					}
				}
			}
			if(keep == false && itemMrNos.get(r.Request_No) != null)
			{
				keep = true;
			}
			if(keep)
			{
				m = Map();
				m.put("Request_No", r.Request_No);
				if(r.Date_field != null)
				{
					m.put("Date_field", r.Date_field.toString("dd-MMM-yyyy"));
				}
				else
				{
					m.put("Date_field", "");
				}
				dB = "";
				sB = "";
				try
				{
					if(r.Destination_Branch != null)
					{
						dB = r.Destination_Branch.Name;
					}
				}
				catch (e6)
				{
					dB = "";
				}
				try
				{
					if(r.Source_Branch != null)
					{
						sB = r.Source_Branch.Name;
					}
				}
				catch (e7)
				{
					sB = "";
				}
				m.put("Destination_Branch", dB);
				m.put("Source_Branch", sB);
				m.put("Sales_Order_no", refs);
				mrList.add(m);
			}
		}
		data.put("Material_Request_Report", mrList);
		invMap = Map();
		invLines = Sales_Invoice_Line_Items[ITEM_CODE == code];
		for each li in invLines
		{
			if(li.Sales_Invoice != null)
			{
				invId = li.Sales_Invoice.ID.toString();
				em = invMap.get(invId);
				if(em == null)
				{
					em = Map();
					inv = Sales_Invoice[ID == li.Sales_Invoice.ID];
					if(inv != null)
					{
						em.put("Sales_Invoice_No", inv.Invoice_No);
						if(inv.Invoice_Date != null)
						{
							em.put("Sales_Invoice_Date", inv.Invoice_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							em.put("Sales_Invoice_Date", "");
						}
						sono = "";
						try
						{
							if(inv.Sales_Order_NO != null)
							{
								sono = inv.Sales_Order_NO.Order_No;
							}
						}
						catch (e8)
						{
							sono = "";
						}
						em.put("Sales_Order_no", sono);
						icn = "";
						try
						{
							if(inv.Customer != null)
							{
								icn = inv.Customer.Name;
							}
						}
						catch (e9)
						{
							icn = "";
						}
						em.put("Customer", icn);
					}
					em.put("Status", "");
					em.put("Line_Item", List());
					invMap.put(invId, em);
				}
				lim = Map();
				lim.put("ITEM_CODE", li.ITEM_CODE);
				lim.put("QTY", li.QTY);
				liList = em.get("Line_Item");
				liList.add(lim);
			}
		}
		invList = List();
		invKeys = invMap.keys();
		for each k in invKeys
		{
			invList.add(invMap.get(k));
		}
		data.put("API_SALES_INVOICES", invList);
		cnMap = Map();
		cnLines = Credit_Note_Line_Items[ITEM_CODE == code];
		for each li in cnLines
		{
			if(li.Credit_Note != null)
			{
				cnId = li.Credit_Note.ID.toString();
				em = cnMap.get(cnId);
				if(em == null)
				{
					em = Map();
					cnRec = Credit_Note[ID == li.Credit_Note.ID];
					if(cnRec != null)
					{
						em.put("Credit_No", cnRec.Credit_No);
						if(cnRec.Credit_Note_Date != null)
						{
							em.put("Credit_Note_Date", cnRec.Credit_Note_Date.toString("dd-MMM-yyyy"));
						}
						else
						{
							em.put("Credit_Note_Date", "");
						}
						em.put("Credit_Note_Status", cnRec.Credit_Note_Status);
					}
					em.put("Line_Item", List());
					cnMap.put(cnId, em);
				}
				lim = Map();
				lim.put("ITEM_CODE", li.ITEM_CODE);
				lim.put("QTY", li.QTY);
				liList = em.get("Line_Item");
				liList.add(lim);
			}
		}
		cnList = List();
		cnKeys = cnMap.keys();
		for each k in cnKeys
		{
			cnList.add(cnMap.get(k));
		}
		data.put("API_CREDIT_NOTES", cnList);
		response.put("code", 3000);
		response.put("data", data);
	}
	catch (ex)
	{
		response.put("code", 0);
		response.put("data", data);
		response.put("error", ex.toString());
	}
	return response.toString();
}
